# =============================================================
# NEXUS — Environment Configuration Template
# =============================================================
# Copy this file to backend/.env or .env and configure your values.
# NEVER commit unencrypted credentials or .env to version control.

# ── Application Mode ──────────────────────────────────────────
DEBUG=true
# Set ALLOW_DEMO=true for unauthenticated local development / review
ALLOW_DEMO=true

# ── Database ──────────────────────────────────────────────────
# SQLite default for local evaluation (data persisted in data/synchain.db)
DATABASE_URL=sqlite:///data/synchain.db
# PostgreSQL for production environments:
# DATABASE_URL=postgresql://nexus_user:your_password@localhost:5432/nexus

# ── Security & Authentication ─────────────────────────────────
# Required for production mode. Generate with:
# python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=change_this_to_a_secure_random_string_in_production_min_32_chars

# Token Lifetimes
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=30

# ── CORS Configuration ────────────────────────────────────────
CORS_ORIGINS=http://localhost:3000

# ── LLM Inference Provider ───────────────────────────────────
# Options: offline (deterministic heuristics) | groq | bedrock
LLM_PROVIDER=offline

# Groq API Configuration (Fast Llama-3.3 inference; free tier at console.groq.com)
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile

# AWS Bedrock Configuration (Optional enterprise LLM provider)
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
BEDROCK_MODEL_ID=amazon.nova-lite-v1:0

# ── Upload & Pipeline Limits ──────────────────────────────────
MAX_UPLOAD_BYTES=52428800     # 50 MB
MAX_ANALYSIS_ROWS=100000      # 100k row processing cap
DATA_QUALITY_THRESHOLD=0.85

# ── Observability (Optional) ──────────────────────────────────
# LANGFUSE_PUBLIC_KEY=
# LANGFUSE_SECRET_KEY=
# LANGFUSE_HOST=https://cloud.langfuse.com
