# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
node_modules/
/.venv/
.venv/
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
**/.next/
/out/
**/out/
.next/
node_modules/.cache/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (allow .env.example)
.env*
!.env.example
!**/.env.example

# IDE
.vscode/

# dependencies
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# python
__pycache__/
*.py[cod]
.pytest_cache/
**/__pycache__/
**/*.py[cod]

# local runtime data
data/*.db-shm
data/*.db-wal
data/*.db
data/chroma_db/
data/documents/
test_output.txt

# one-off debug scripts (not project tests)
debug_*.py
test_*.csv
test_output.txt

# temporary files
tmp/
*.log
*.err

# cache and build files
frontend/.next/
**/.next/
.turbopack/

# documentation drafts
AWS_INTEGRATION_GUIDE.md
BACKEND_AUDIT.md
FRONTEND_AUDIT.md

# security — never commit these
*.db
*.db-shm
*.db-wal
nexus.db
*.pem
*.key
*.p12
*.pfx
secrets.json
credentials.json
